# ---------- shared ----------
APP_ENV=development                  # development | demo
SERVICE_KEY=                         # long random string, identical on backend / ml_service / speech_service
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:8000
ML_SERVICE_URL=http://localhost:8001
SPEECH_SERVICE_URL=http://localhost:8002
OLLAMA_URL=http://localhost:11434

# ---------- backend ----------
DATABASE_URL=sqlite:///./backend/data/velora.db
STORAGE_DIR=./backend/storage
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_SUPERVISOR=
SEED_PASSWORD_INVESTIGATOR=
SEED_PASSWORD_ARTIST=
SEED_PASSWORD_AUDITOR=

# ---------- LLM ----------
GEMINI_API_KEY=                    # from Google AI Studio (free tier). Demo-mode cases only.
GEMINI_MODEL_FAST=                 # pick from AI Studio model list (a Flash-Lite class model)
GEMINI_MODEL_SMART=                # pick from AI Studio model list (a Flash class model)
OLLAMA_MODEL=                      # chosen by scripts/pick_ollama_model.py (B3)
LLM_PROVIDER_MODE=auto              # auto | gemini | ollama (real cases ignore gemini regardless)
LLM_TIMEOUT_S=12
LLM_MAX_RETRIES=1
GEMINI_RPM=8
LLM_CACHE_TTL_S=3600

# ---------- ml_service ----------
ML_MODELS_DIR=./ml_service/models
ML_STORAGE_DIR=./ml_service/storage
ML_DEVICE=cuda
ML_IMAGE_SIZE=512
ML_VARIANT_STEPS=4
LOW_VRAM_MODE=auto                  # auto | true | false
HF_TOKEN=                            # optional

# ---------- speech_service ----------
WHISPER_MODEL=medium                 # tiny|base|small|medium|large-v3 (pick by VRAM/latency)
WHISPER_COMPUTE_TYPE=int8_float16    # int8 on CPU
INDICTRANS_MODEL_EN_INDIC=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS_MODEL_INDIC_EN=ai4bharat/indictrans2-indic-en-dist-200M

# ---------- optional hosted image fallback (synthetic-data augmentation only) ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---------- frontend (Vite) ----------
VITE_API_BASE=http://localhost:8000/api/v1
